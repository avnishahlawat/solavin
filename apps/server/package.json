    "@prisma/client": "^5.14.0",
    "@solavin/shared": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "prisma": "^5.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
